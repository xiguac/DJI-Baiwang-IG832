#!/bin/sh

case "$1" in
  start)
    [ -x /data/module-panel/start.sh ] && /data/module-panel/start.sh >/dev/null 2>&1 &
    ;;
  stop)
    [ -x /data/module-panel/stop.sh ] && /data/module-panel/stop.sh >/dev/null 2>&1
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac

exit 0
